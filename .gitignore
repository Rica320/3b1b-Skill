# ── Render output ────────────────────────────────────────────────────────
# ManimGL writes videos/ and images/ next to the scene file; render_meta.json
# and _field_cache/ are regenerated on every run.
images/
_field_cache/
render_meta.json
partial_movie_file_list.txt

# ── Generated assets ─────────────────────────────────────────────────────
# Derived from the Olivetti faces dataset by examples/gans/prepare_assets.py.
# Not redistributed here — run that script once before rendering.
examples/gans/assets/faces/

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class\
*.so
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
MANIFEST

# ── Virtual environments ─────────────────────────────────────────────────
env/
venv/
.venv/
ENV/

# ── LaTeX / ffmpeg leavings ──────────────────────────────────────────────
*.log
*.aux
*.dvi
tex/

# ── Local configuration ──────────────────────────────────────────────────
# Note: each example's own custom_config.yml IS tracked — it is part of the
# example. Only machine-local overrides are ignored.
settings.local.json
*.local
.env
.env.local

# ── Editors and OS ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Notebooks and scratch ────────────────────────────────────────────────
.ipynb_checkpoints/
.cache/
*.tmp
*.temp
